{
  "expo": {
    "name": "Kerri",
    "slug": "tennis-coach-app",
    "owner": "skeun-2",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a7a4a"
    },
    "privacyPolicyUrl": "https://skeun88.github.io/tennis-coach-app/privacy-policy.html",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kerri.tenniscoach",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "Kerri",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "레슨 피드백을 녹음하고 AI 코칭 모델에 업로드하기 위해 마이크 접근이 필요합니다.",
        "NSUserNotificationUsageDescription": "레슨 출석 체크 알림을 위해 알림 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "코치 프로필 사진을 등록하거나 변경할 때 사진 라이브러리에 접근합니다. 예: 프로필 화면에서 사진 선택 시 사용됩니다.",
        "UIBackgroundModes": [
          "audio"
        ],
        "LSApplicationQueriesSchemes": [
          "naversearchapp",
          "naversearchthirdlogin"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a7a4a"
      },
      "package": "com.tenniscoach.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "tenniscoach",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "레슨 피드백 녹음을 위해 마이크 접근이 필요합니다.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1B4332",
          "sounds": [],
          "mode": "development"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "@react-native-seoul/naver-login",
        {
          "urlScheme": "tenniscoach"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ed6ab94-326e-4ac4-8436-7463181a3c34"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1ed6ab94-326e-4ac4-8436-7463181a3c34"
    }
  }
}
