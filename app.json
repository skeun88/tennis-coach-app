{
  "expo": {
    "name": "테니스 코치",
    "slug": "tennis-coach-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a7a4a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kerri.tenniscoach",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "레슨 피드백 녹음을 위해 마이크 접근이 필요합니다.",
        "NSUserNotificationUsageDescription": "레슨 출석 체크 알림을 위해 알림 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a7a4a"
      },
      "package": "com.tenniscoach.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "tenniscoach",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "레슨 피드백 녹음을 위해 마이크 접근이 필요합니다.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1B4332",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1be1b5a5-4743-4a9d-bdf2-286a448fa5e5"
      }
    }
  }
}
